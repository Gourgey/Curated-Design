---
pagination:
  data: apps.items
  size: 1
  alias: app
permalink: "apps/{{ app.slug }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{% if app.metaTitle %}{{ app.metaTitle }}{% else %}{{ app.name }} – Apps by Curated Design{% endif %}"
  description: "{% if app.metaDescription %}{{ app.metaDescription }}{% else %}{{ app.description }}{% endif %}"
htmlClass: app-page
bodyClass: app-page min-h-screen font-inter
sectionTop: true
---
{% from "partials/backlink.njk" import pill as backlinkPill -%}
<main id="main-content" class="page-main" tabindex="-1">
    {% include "partials/hero-brand.njk" %}

    <section class="app-content">
        <div class="app-wrap app-wrap--narrow">
            {{ backlinkPill("/apps/", "Back to Digital Tools") }}

            <header class="app-header">
                <p class="app-kicker">{{ app.eyebrow }}</p>
                <h1 class="app-title">{{ app.name }}</h1>
                <p class="app-lead">{{ app.overview }}</p>
            </header>

            {% if app.highlights %}
            <article class="app-prose app-prose--summary">
                <h2>One calm place for studio procurement</h2>
                <ul>
                    {% for highlight in app.highlights %}
                    <li>{{ highlight }}</li>
                    {% endfor %}
                </ul>
                <p>
                    Secure account-based cloud synchronisation keeps authorised studio members up to date. Owners, admins, members, and viewers have permissions appropriate to their role.
                </p>
                <p>
                    ProcureCore has no advertising or cross-app tracking. Essential cloud and subscription providers, and the optional Studio Pro AI assistant, are explained in the <a href="/apps/procurecore/privacy/">Privacy Policy</a>.
                </p>
                <p>
                    Some features require an auto-renewing App Store subscription. Apple shows the current price, billing period, and any eligible introductory offer in the app before purchase. ProcureCore is coming soon.
                </p>
            </article>
            {% endif %}

            <div class="app-detail-grid">
                <article class="app-panel">
                    <h2>App information</h2>
                    <dl class="app-meta-list">
                        {% if app.information %}
                        {% for item in app.information %}
                        <div>
                            <dt>{{ item.label }}</dt>
                            <dd>{% if item.url %}<a href="{{ item.url }}">{{ item.value }}</a>{% else %}{{ item.value }}{% endif %}</dd>
                        </div>
                        {% endfor %}
                        {% else %}
                        {% if app.appStoreUrl %}
                        <div>
                            <dt>App Store</dt>
                            <dd><a href="{{ app.appStoreUrl }}">View on the App Store</a></dd>
                        </div>
                        {% endif %}
                        <div>
                            <dt>Support email</dt>
                            <dd><a href="{{ apps.supportEmailUrl }}">{{ apps.supportEmail }}</a></dd>
                        </div>
                        <div>
                            <dt>Platform</dt>
                            <dd>{{ app.platform }}</dd>
                        </div>
                        <div>
                            <dt>Sync</dt>
                            <dd>{{ app.sync }}</dd>
                        </div>
                        <div>
                            <dt>Privacy</dt>
                            <dd>{{ app.privacySummary }}</dd>
                        </div>
                        {% endif %}
                        <div>
                            <dt>Last updated</dt>
                            <dd>{{ app.lastUpdated or apps.lastUpdated }}</dd>
                        </div>
                    </dl>
                </article>

                <aside class="app-panel app-panel--links" aria-label="{{ app.name }} links">
                    <h2>Support and policies</h2>
                    {% for kind in app.supportPages %}
                    <a href="/apps/{{ app.slug }}/{{ kind }}/">{% if kind == "privacy" %}Privacy Policy{% elif kind == "support" %}Support{% elif kind == "data-processing" %}Data Processing Schedule{% else %}Terms{% endif %}</a>
                    {% endfor %}
                </aside>
            </div>
        </div>
    </section>
</main>
