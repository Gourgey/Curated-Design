{#
  The ProcureCore app opens this link itself and uses the one-time reset
  details. This page must never call Supabase (that would use the link up).
  Its only script picks which message to show when the URL says the link
  has expired; without JavaScript the default message shows.
#}
<section class="recovery-state" data-state="default" aria-labelledby="recovery-default-title">
  <h1 id="recovery-default-title" class="recovery-title" tabindex="-1">
    Reset your password in ProcureCore
  </h1>
  <p class="recovery-copy">Password resets happen inside the app so your account stays secure.</p>
  <ol class="recovery-steps">
    <li>On the iPhone, iPad or Mac where ProcureCore is installed, open the reset email.</li>
    <li>Tap the reset link there; ProcureCore opens and asks for your new password.</li>
    <li>
      If the link opens a browser instead, open the email in Apple Mail or Safari, or long-press
      the link and choose <strong>Open in ProcureCore</strong>.
    </li>
  </ol>
</section>

<section class="recovery-state" data-state="expired" aria-labelledby="recovery-expired-title" hidden>
  <h1 id="recovery-expired-title" class="recovery-title" tabindex="-1">
    This reset link has expired
  </h1>
  <ol class="recovery-steps">
    <li>Open ProcureCore.</li>
    <li>On the sign-in screen choose <strong>Forgot password?</strong> to get a new link.</li>
  </ol>
  <p class="recovery-note">Reset links last one hour.</p>
</section>
