---
layout: layouts/base.njk
eleventyComputed:
  title: "{{ site.home.title }}"
  description: "{{ site.home.metaDescription or site.settings.description }}"
bodyClass: min-h-screen text-[#f2f2f2] font-inter
topLogo: white_logo_no_text_on_transparent.svg
showBackground: true
---
<main id="main-content" class="page-main" tabindex="-1">
    {% set logoFile = "white_small_logo_and_large_text_on_transparent.svg" %}
    {% include "partials/hero-brand.njk" %}

    <section class="hero">
        <div class="container hero-inner hero-inner--center">
            <h1 class="home-hero__title">{{ site.home.hero.headline | safe }}</h1>
            <p class="home-hero__intro">{{ site.home.hero.subhead }}</p>
        </div>
    </section>

    <nav id="pills" class="pillmenu-wrap" aria-label="Quick filters">
        <button
            id="pillsToggle"
            class="pillmenu-toggle pills-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="pillsPanel"
        >
            <span class="pills-toggle-label">Menu</span>
        </button>

        {% set processLabel = site.home.process.kicker or "The Process" %}
        <ul class="pillmenu pills-desktop">
            <li><a class="pill active" href="#process">{{ processLabel }}</a></li>
            <li><a class="pill" href="#services">Curated Services</a></li>
            <li><a class="pill" href="#selected-work">Collections</a></li>
            <li><a class="pill" href="#about">Design Philosophy</a></li>
        </ul>

        <div id="pillsPanel" class="pills-panel" hidden>
            <a class="pill" href="#process">{{ processLabel }}</a>
            <a class="pill" href="#services">Curated Services</a>
            <a class="pill" href="#selected-work">Collections</a>
            <a class="pill" href="#about">Design Philosophy</a>
        </div>
    </nav>

    {# The Process — a step carousel in the hero dock. Every step is in the
       markup with the first one open, so it reads fully without JS;
       carousels.js adds the stepping. #}
    {% set steps = site.home.process.steps or [] %}
    {% if steps.length %}
    <section
        id="process"
        class="process-dock"
        data-theme="dark"
        data-process-carousel
        aria-roledescription="carousel"
        aria-label="{{ processLabel }}"
    >
        <div class="process-dock__head">
            <p class="process-dock__kicker">{{ processLabel }}</p>
            {% if site.home.process.heading %}
            <h2 class="process-dock__title">{{ site.home.process.heading }}</h2>
            {% endif %}
            <div class="process-dock__controls">
                <span class="process-dock__count" data-process-count aria-live="polite">01 / {{ "0" + steps.length if steps.length < 10 else steps.length }}</span>
                <button class="process-dock__arrow" type="button" data-process-prev aria-label="Previous step">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 2 4 6l4 4"/></svg>
                </button>
                <button class="process-dock__arrow" type="button" data-process-next aria-label="Next step">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 2 4 4-4 4"/></svg>
                </button>
            </div>
        </div>

        <ol class="process-dock__steps">
            {% for step in steps %}
            <li class="process-step{% if loop.first %} is-active{% endif %}" data-process-step>
                <button class="process-step__toggle" type="button" aria-expanded="{{ 'true' if loop.first else 'false' }}" aria-controls="process-step-{{ loop.index }}" data-process-toggle>
                    <span class="process-step__num">{{ "0" + loop.index if loop.index < 10 else loop.index }}</span>
                    <span class="process-step__label">{{ step.label }}</span>
                    <span class="process-step__title">{{ step.title }}</span>
                </button>
                <div class="process-step__detail" id="process-step-{{ loop.index }}"{% if not loop.first %} hidden{% endif %}>
                    <p class="process-step__text">{{ step.text }}</p>
                    {% if step.receive %}
                    <p class="process-step__receive">You receive · {{ step.receive }}</p>
                    {% endif %}
                </div>
            </li>
            {% endfor %}
        </ol>

        <div class="process-dock__foot">
            <div class="process-dock__progress" aria-hidden="true">
                {% for step in steps %}<span{% if loop.first %} class="is-done"{% endif %}></span>{% endfor %}
            </div>
            {% if site.home.process.closing %}
            <p class="process-dock__closing">{{ site.home.process.closing }}</p>
            {% endif %}
            {% if site.home.process.linkLabel %}
            <a class="process-dock__link" href="/contact/">{{ site.home.process.linkLabel }}</a>
            {% endif %}
        </div>
    </section>
    {% endif %}

    <section id="services" class="home-section home-services" data-theme="dark">
        <div class="home-section__inner">
            <div class="home-section__head">
                <p class="home-section__eyebrow">{{ site.home.servicesSection.kicker }}</p>
                <div>
                    <h2 class="home-section__title">{{ site.home.servicesSection.heading | safe }}</h2>
                    {% if site.home.servicesSection.lead %}
                    <p class="home-section__intro">{{ site.home.servicesSection.lead }}</p>
                    {% endif %}
                </div>
            </div>

            {% set featuredServices = site.home.servicesSection.featuredServices | resolveEntries(collections.publishedService, "service") %}
            <div class="home-services__grid">
                {% for service in featuredServices %}
                <a class="card card--service" href="/services/{{ service.data.slug }}/">
                    <div class="card__media">
                        {% image service.data.cardImage, service.data.cardAlt or service.data.title, "(min-width: 1280px) 400px, (min-width: 761px) 33vw, 100vw", "lazy", "", "card" %}
                    </div>
                    <h3 class="card__title">{{ service.data.title }}</h3>
                    {% if service.data.summary %}
                    <p class="card__summary">{{ service.data.summary }}</p>
                    {% endif %}
                </a>
                {% endfor %}
            </div>

            {% if site.home.servicesSection.moreLink %}
            <div class="home-services__more">
                {% if site.home.servicesSection.moreLabel %}
                <p class="home-services__more-label">{{ site.home.servicesSection.moreLabel }}</p>
                {% endif %}
                <a class="home-services__more-link" href="{{ site.home.servicesSection.moreHref or '/services/' }}">{{ site.home.servicesSection.moreLink }}</a>
            </div>
            {% endif %}
        </div>
    </section>

    <section id="selected-work" class="home-section home-collections" data-theme="light">
        <div class="home-section__inner">
            <div class="home-section__head">
                <p class="home-section__eyebrow">{{ site.home.collectionsSection.kicker }}</p>
                <div>
                    <h2 class="home-section__title">{{ site.home.collectionsSection.heading | safe }}</h2>
                    {% if site.home.collectionsSection.lead %}
                    <p class="home-section__intro">{{ site.home.collectionsSection.lead }}</p>
                    {% endif %}
                </div>
            </div>

            {% set featuredProjects = site.home.collectionsSection.featuredProjects | resolveEntries(collections.publishedProject, "project") %}
            {% if featuredProjects.length == 1 %}
            {# One featured project: a larger spread — main image, a detail
               image from its gallery, and an info tile. #}
            {% set featured = featuredProjects[0] %}
            {% set projectCardSrc = featured.relation.image or featured.data.cardImage %}
            {% set detailImage = featured.data.gallery.images[0] if (featured.data.gallery and featured.data.gallery.images and featured.data.gallery.images.length) else null %}
            <div class="home-feature">
                <a class="home-feature__main" href="/work/{{ featured.data.slug }}/">
                    {% image projectCardSrc, featured.data.cardAlt or featured.data.title, "(min-width: 1280px) 840px, (min-width: 761px) 66vw, 100vw", "lazy" %}
                    <span class="home-feature__badge">Completed</span>
                </a>
                <div class="home-feature__side">
                    {% if detailImage %}
                    <div class="home-feature__detail">
                        {% image detailImage.image, detailImage.alt or featured.data.title, "(min-width: 1280px) 400px, (min-width: 761px) 33vw, 100vw", "lazy" %}
                    </div>
                    {% endif %}
                    <div class="home-feature__info">
                        <div>
                            {% if featured.data.kicker %}<p class="home-project__kicker">{{ featured.data.kicker }}</p>{% endif %}
                            <h3 class="home-feature__title"><a href="/work/{{ featured.data.slug }}/">{{ featured.data.title }}</a></h3>
                            {% if featured.data.projectTags and featured.data.projectTags.length %}
                            <p class="home-feature__tags">{{ featured.data.projectTags | join(" · ") }}</p>
                            {% endif %}
                        </div>
                        {% if site.home.collectionsSection.moreLink %}
                        <div class="home-feature__more">
                            {% if site.home.collectionsSection.moreLabel %}<span class="home-collections__more-label">{{ site.home.collectionsSection.moreLabel }}</span>{% endif %}
                            <a class="home-collections__more-link" href="{{ site.home.collectionsSection.moreHref or '/work/' }}">{{ site.home.collectionsSection.moreLink }}</a>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% else %}
            <div class="home-collections__grid">
                {% for project in featuredProjects %}
                {% set projectCardSrc = project.relation.image or project.data.cardImage %}
                <a class="home-project" href="/work/{{ project.data.slug }}/">
                    <div class="home-project__media">
                        {% image projectCardSrc, project.data.cardAlt or project.data.title, "(min-width: 1280px) 400px, (min-width: 761px) 33vw, 100vw", "lazy", "", "card" %}
                    </div>
                    <h3 class="home-project__title">{{ project.data.title }}</h3>
                    {% if project.data.kicker %}
                    <p class="home-project__kicker">{{ project.data.kicker }}</p>
                    {% endif %}
                </a>
                {% endfor %}
            </div>

            {% if site.home.collectionsSection.moreLink %}
            <div class="home-collections__more">
                {% if site.home.collectionsSection.moreLabel %}
                <p class="home-collections__more-label">{{ site.home.collectionsSection.moreLabel }}</p>
                {% endif %}
                <a class="home-collections__more-link" href="{{ site.home.collectionsSection.moreHref or '/work/' }}">{{ site.home.collectionsSection.moreLink }}</a>
            </div>
            {% endif %}
            {% endif %}
        </div>
    </section>

    <section id="about" class="home-philosophy" data-theme="dark">
        <div class="home-philosophy__inner">
            <figure class="home-philosophy__media">
                {% image site.home.philosophy.image, site.home.philosophy.imageAlt, "(min-width: 1280px) 600px, (min-width: 761px) 50vw, 100vw", "lazy" %}
            </figure>
            <div class="home-philosophy__body">
                <p class="home-philosophy__eyebrow">{{ site.home.philosophy.kicker }}</p>
                <h2 class="home-philosophy__title">{{ site.home.philosophy.heading | safe }}</h2>
                {% for paragraph in site.home.philosophy.paragraphs %}
                <p class="home-philosophy__text">{{ paragraph }}</p>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="home-cta" data-theme="dark" aria-label="Contact call to action">
        <div class="home-cta__inner">
            {% if site.home.cta.kicker %}
            <p class="home-cta__eyebrow">{{ site.home.cta.kicker }}</p>
            {% endif %}
            <h2 class="home-cta__title">{{ site.home.cta.heading | safe }}</h2>
            {% if site.home.cta.text %}
            <p class="home-cta__subline">{{ site.home.cta.text }}</p>
            {% endif %}
            <a class="home-cta__link" href="{{ site.settings.primaryCtaUrl or ('mailto:' + site.settings.email) }}">
                <span class="home-cta__dot" aria-hidden="true"></span>
                {{ site.home.cta.buttonLabel }}
            </a>
        </div>
    </section>
</main>
