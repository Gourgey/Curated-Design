---
layout: layouts/base.njk
title: Apps by Curated Design – Curated Design Studio
description: Digital tools and app support pages by Curated Design Studio.
permalink: apps/index.html
htmlClass: app-page
bodyClass: app-page min-h-screen font-inter
sectionTop: true
---
<main id="main-content" class="page-main" tabindex="-1">
    {% include "partials/hero-brand.njk" %}

    <section class="app-content">
        <div class="app-wrap">
            <header class="app-header">
                <p class="app-kicker">Digital Tools</p>
                <h1 class="app-title">Apps by Curated Design</h1>
                <p class="app-lead">
                    A small collection of practical tools developed alongside the studio. They sit quietly here for support and privacy reference.
                </p>
            </header>
        </div>

        <div class="app-showcase">
            {% for app in apps.items %}
            <article class="app-feature{% if loop.index is even %} app-feature--reverse{% endif %}" id="app-{{ app.slug }}" aria-labelledby="app-{{ app.slug }}-title">
                <div class="app-feature-inner">
                    <div class="app-feature-copy">
                        <p class="app-feature-kicker"><span class="app-feature-index">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>{{ app.eyebrow }}</p>
                        <h2 class="app-feature-title" id="app-{{ app.slug }}-title">
                            <a href="/apps/{{ app.slug }}/">{{ app.name }}</a>
                        </h2>
                        <p class="app-feature-desc">{{ app.description }}</p>
                        {% if app.platform %}<p class="app-feature-platform">{{ app.platform }}</p>{% endif %}
                        <a class="app-feature-link" href="/apps/{{ app.slug }}/" aria-label="View {{ app.name }} details">View details<span aria-hidden="true">&rarr;</span></a>
                    </div>

                    {% if app.screenshots and app.screenshots.length %}
                    {% set isDesktop = app.screenshotLayout == "desktop" %}
                    <div class="app-feature-stage{% if isDesktop %} app-feature-stage--desktop{% endif %}">
                        {% for shot in app.screenshots %}{% if loop.index0 < 3 %}
                        {% if isDesktop %}
                        <figure class="app-window app-window--{{ ['front', 'back-start', 'back-end'][loop.index0] }}">
                            {% image shot.src, shot.alt, "(max-width: 820px) 80vw, 560px", "lazy", "app-window-screen", "card" %}
                        </figure>
                        {% else %}
                        <figure class="app-phone app-phone--{{ ['front', 'back-start', 'back-end'][loop.index0] }}">
                            {% image shot.src, shot.alt, "(max-width: 820px) 40vw, 300px", "lazy", "app-phone-screen", "card" %}
                        </figure>
                        {% endif %}
                        {% endif %}{% endfor %}
                    </div>
                    {% else %}
                    <div class="app-feature-stage app-feature-stage--type" aria-hidden="true">
                        {% if app.logo %}
                        <img class="app-feature-logo" src="{{ app.logo }}" alt="" width="220" height="220" loading="lazy" decoding="async">
                        {% else %}
                        <span class="app-feature-wordmark">{{ app.name }}</span>
                        {% endif %}
                        <span class="app-feature-soon">Screens coming soon</span>
                    </div>
                    {% endif %}
                </div>
            </article>
            {% endfor %}
        </div>

        <div class="app-wrap">
            <p class="app-small-note">
                The main studio remains focused on interiors, procurement, and design work. These pages provide public app information and support links.
            </p>
        </div>
    </section>
</main>
