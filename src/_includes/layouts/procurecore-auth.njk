<!doctype html>
{#
  Shared shell for ProcureCore's account-link pages under /auth/. These pages
  are deliberately independent from the main site shell (no nav, no site
  scripts, no analytics). Each page sets: title, description, canonicalPath,
  and optionally pageScripts (a list of { src, integrity } objects; only
  same-origin scripts plus the pinned supabase-js build are allowed by the
  per-route CSP in netlify.toml).
#}
<html lang="en-GB" class="recovery-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }} – ProcureCore</title>
    <meta name="description" content="{{ description }}" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <link rel="canonical" href="https://curateddesign.studio{{ canonicalPath }}" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/assets/fonts/inter-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/cormorant-garamond-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/assets/css/styles.css?v={{ site.cssVersion }}" />
  </head>
  <body class="recovery-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main id="main-content" class="recovery-main" tabindex="-1">
      <div class="recovery-card">
        <p class="recovery-kicker">ProcureCore</p>
        {{ content | safe }}
        <footer class="recovery-footer">
          <a href="/apps/procurecore/support/" rel="noreferrer">ProcureCore Support</a>
          <a href="{{ procurecoreAppStoreUrl }}" rel="noreferrer">ProcureCore on the App Store</a>
        </footer>
      </div>
    </main>
    {%- for script in pageScripts %}
    <script src="{{ script.src }}"{% if script.integrity %} integrity="{{ script.integrity }}" crossorigin="anonymous"{% endif %} defer></script>
    {%- endfor %}
  </body>
</html>
