---
layout: layouts/base.njk
title: Interior Design Services in London – Curated Design Studio
eleventyComputed:
  description: "{{ site.servicesPage.metaDescription or site.settings.description }}"
permalink: services/index.html
htmlClass: services-page
bodyClass: services-page font-inter
topLogo: logo_no_text_on_transparent.svg
---
<main id="main-content" class="page-main" tabindex="-1">
    <header class="projects-header">
        {% if site.servicesPage.eyebrow %}
        <p class="projects-header__eyebrow">{{ site.servicesPage.eyebrow }}</p>
        {% endif %}
        <div>
            <h1 class="projects-header__title">{{ site.servicesPage.heroHeadline | safe }}</h1>
            {% if site.servicesPage.heroSubhead %}
            <p class="projects-header__intro">{{ site.servicesPage.heroSubhead }}</p>
            {% endif %}
        </div>
    </header>

    {% for group in site.servicesPage.groups %}
    <section class="projects-section service-group" id="{{ group.id }}" aria-labelledby="{{ group.id }}-title">
        <div class="projects-section__inner">
            <header class="service-group__head">
                <p class="label-small">0{{ loop.index }}</p>
                <h2 class="projects-header__title" id="{{ group.id }}-title">{{ group.title }}</h2>
                <p class="projects-header__intro">{{ group.intro }}</p>
                <p class="projects-header__intro">{{ group.commissioning }}</p>
            </header>
            {% if group.entries %}
            {% set entries = group.entries | resolveEntries(collections.publishedService, "service") %}
            <div class="projects-grid">
                {% for service in entries %}
                <a class="card card--service"{% if service.data.slug == "bespoke_furnishing" %} id="furnishing-design"{% endif %} href="/services/{{ service.data.slug }}/">
                    <div class="card__media">
                        {% image service.data.cardImage, service.data.cardAlt or service.data.title, "(min-width: 1024px) 33vw, (min-width: 641px) 50vw, 100vw", "lazy", "", "card" %}
                    </div>
                    <h3 class="card__title">{{ service.data.title }}</h3>
                    {% if service.data.summary %}
                    <p class="card__summary">{{ service.data.summary }}</p>
                    {% endif %}
                </a>
                {% endfor %}
            </div>
            {% else %}
            <ul class="service-group__capabilities">
                <li>Photorealistic Interior CGI</li>
                <li>3D Property Walkthroughs</li>
                <li>Visualisation for Design Proposals</li>
            </ul>
            <a href="{{ group.url }}">Explore CGI &amp; Visualisation →</a>
            {% endif %}
        </div>
    </section>
    {% endfor %}

    {# Mirrored as FAQPage structured data in layouts/base.njk. #}
    {% set faqs = site.servicesPage.faqs %}
    {% if faqs and faqs.length %}
    <section class="projects-section services-faq" aria-labelledby="services-faq-title">
        <div class="projects-section__inner">
            <h2 class="services-faq__title" id="services-faq-title">{{ site.servicesPage.faqHeading or "Frequently asked questions" }}</h2>
            <div class="services-faq__list">
                {% for faq in faqs %}
                {% if faq.question and faq.answer %}
                <div class="services-faq__item">
                    <h3 class="services-faq__question">{{ faq.question }}</h3>
                    <p class="services-faq__answer">{{ faq.answer }}</p>
                </div>
                {% endif %}
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <section class="projects-section property-professionals" aria-labelledby="property-professionals-title">
        <div class="projects-section__inner">
            <p class="label-small">For property professionals</p>
            <h2 class="projects-header__title" id="property-professionals-title">Design-led solutions for the property market.</h2>
            <p>We work with estate agents, developers and property owners to create thoughtful furnishing proposals, visualisations and interior schemes that help communicate the potential of residential properties.</p>
            <p>From initial design concepts to furniture specification, procurement and installation, our approach can be tailored to individual properties and commercial objectives.</p>
            <a href="/contact/">Enquire about a property project →</a>
        </div>
    </section>
</main>
